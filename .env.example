# Copy this file to .env and fill in what you need.
# All of these are optional — the site builds without them.

# Optional: raises the GitHub API rate limit from 60 to 5,000 requests/hour.
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Optional: your production URL, used for canonical links, sitemap and OG images.
# SITE=https://yourname.dev

# Optional: base path when hosting under a subdirectory (e.g. GitHub Pages project sites).
# BASE_PATH=/my-portfolio
