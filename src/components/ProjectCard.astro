---
import type { Project } from '../lib/projects';
import { videoSrc, posterSrc, shotSrc, shotAlt, shotLabel } from '../lib/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const flip = index % 2 === 1; // alternate media side per station
const shots = Array.from({ length: project.shotCount }, (_, i) => i);
---

<article class="station relative py-16 sm:py-20" id={project.slug} data-station>
  <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
    <!-- Media column: walkthrough video + stills -->
    <div class={flip ? 'lg:order-2' : ''} data-reveal>
      <figure>
        <div class="video-frame">
          <video
            controls
            preload="metadata"
            playsinline
            poster={posterSrc(project)}
            aria-label={`${project.name} — walkthrough video`}
          >
            <source src={videoSrc(project)} type="video/mp4" />
            Your browser does not support embedded video — the walkthrough is also available as stills below.
          </video>
        </div>
        <figcaption class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-muted">
          <span class="mt-0.5 shrink-0 font-mono-label text-cyan" aria-hidden="true">▶ demo</span>
          <span>{project.caption}</span>
        </figcaption>
      </figure>

      <!-- Screenshot stills — open the lightbox -->
      <div class="mt-5 grid grid-cols-4 gap-2.5" role="group" aria-label={`${project.name} — screenshot stills`}>
        {shots.map((i) => (
          <button
            type="button"
            class="shot-thumb"
            data-lightbox-trigger
            data-group={project.slug}
            data-src={shotSrc(project, i)}
            data-alt={shotAlt(project, i)}
            aria-label={`Open still ${i + 1} of ${project.shotCount}: ${project.name}`}
          >
            <img src={shotSrc(project, i)} alt="" loading="lazy" decoding="async" width="640" height="360" />
            <span class="shot-label" aria-hidden="true">{shotLabel(i)}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Copy column -->
    <div class={flip ? 'lg:order-1' : ''}>
      <div class="flex items-baseline gap-4" data-reveal>
        <span class="station-num" aria-hidden="true">{n}</span>
        <div>
          <p class="font-mono-label text-violet">{project.category}</p>
          <h3 class="font-display mt-1.5 text-2xl font-semibold leading-snug sm:text-3xl">
            {project.name}
          </h3>
        </div>
      </div>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg" data-reveal style="--reveal-delay: 80ms">
        {project.lede}
      </p>

      <ul class="features mt-6 flex list-none flex-col gap-3 text-[0.95rem] leading-relaxed text-ink/90" data-reveal style="--reveal-delay: 140ms">
        {project.features.map((f) => <li>{f}</li>)}
      </ul>

      <div class="mt-6 flex flex-wrap gap-1.5" data-reveal style="--reveal-delay: 200ms" aria-label="Tech stack">
        {project.tags.map((t) => <span class="tag">{t}</span>)}
      </div>

      <div class="mt-7 flex flex-wrap gap-3" data-reveal style="--reveal-delay: 260ms">
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link-chip"
          data-kind={project.isPrivate ? 'private' : 'repo'}
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          {project.isPrivate ? 'Private repo' : 'View repo'}
        </a>
        {project.liveUrl && (
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="link-chip" data-kind="live">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <circle cx="8" cy="8" r="6.4"></circle>
              <path d="M1.6 8h12.8M8 1.6c1.8 1.8 2.7 4 2.7 6.4s-.9 4.6-2.7 6.4C6.2 12.6 5.3 10.4 5.3 8s.9-4.6 2.7-6.4Z"></path>
            </svg>
            Live demo
          </a>
        )}
      </div>
    </div>
  </div>
</article>
