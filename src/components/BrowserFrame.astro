---
interface Props {
  url?: string;
  class?: string;
}
const { url = 'example.com', class: className = '' } = Astro.props;
---

<figure class={`browser-frame overflow-hidden rounded-xl border border-line bg-surface shadow-xl ${className}`}>
  <div class="flex items-center gap-2 border-b border-line bg-surface-2 px-4 py-2.5" aria-hidden="true">
    <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
    <span class="ml-3 flex-1 truncate rounded-md bg-bg px-3 py-1 text-center font-mono text-[11px] text-muted">{url}</span>
  </div>
  <div class="bg-surface">
    <slot />
  </div>
</figure>
