---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`phone-frame mx-auto w-[240px] rounded-[2.4rem] border border-line bg-surface p-2 shadow-xl ${className}`}>
  <div class="relative overflow-hidden rounded-[1.9rem] bg-bg">
    <div class="absolute top-2 left-1/2 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-surface" aria-hidden="true"></div>
    <slot />
  </div>
</figure>
