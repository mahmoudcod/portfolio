---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['mb-10 max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-muted">{description}</p>}
</div>
