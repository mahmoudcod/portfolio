---
import { site, nav } from '../lib/site.config';
import { u } from '../lib/urls';
---

<header class="site-header" data-header>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <!-- Brand -->
    <a href={u('/#top')} class="group flex items-center gap-3" aria-label={`${site.name} — home`}>
      <span
        class="grid size-9 place-items-center rounded-xl border border-line bg-panel font-display text-sm font-bold text-gradient"
        aria-hidden="true">MK</span>
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-display text-sm font-semibold">{site.name}</span>
        <span class="text-xs text-muted">{site.title}</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a href={u(item.href)} class="nav-link" data-nav-link data-target={item.href.replace('/#', '#')}>
          {item.label}
        </a>
      ))}
      <button
        type="button"
        class="hidden items-center gap-2 rounded-lg border border-line px-3 py-2 text-xs font-medium text-muted transition-colors hover:text-cyan md:flex"
        data-motion-toggle
        aria-pressed="false"
        title="Play or pause the site's animations"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M1 4h14M3 8h10M5 12h6"></path>
        </svg>
        <span data-motion-label>Motion</span>
      </button>
      <a href={`mailto:${site.email}`} class="btn btn-primary !px-4 !py-2 text-sm">Hire me</a>
    </nav>

    <!-- Mobile controls -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        class="grid size-10 place-items-center rounded-lg border border-line bg-panel"
        data-motion-toggle
        aria-pressed="false"
        aria-label="Toggle animations"
        title="Play or pause the site's animations"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M1 4h14M3 8h10M5 12h6"></path>
        </svg>
      </button>
      <button
      type="button"
      class="grid size-10 place-items-center rounded-lg border border-line bg-panel md:hidden"
      data-menu-open
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="menu-panel md:!hidden" data-menu-panel aria-hidden="true">
    <div class="absolute inset-0 bg-void/80 backdrop-blur-sm" data-menu-overlay></div>
    <div
      class="absolute inset-y-0 end-0 flex w-72 max-w-[85vw] flex-col border-s border-line bg-deep p-6 transition-transform duration-300 translate-x-full"
      data-menu-content
    >
      <div class="flex items-center justify-between">
        <span class="font-arabic text-lg text-cyan" lang="ar" aria-hidden="true">{site.nameAr}</span>
        <button
          type="button"
          class="grid size-10 place-items-center rounded-lg border border-line"
          data-menu-close
          aria-label="Close menu"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <nav class="mt-8 flex flex-col gap-1" aria-label="Mobile">
        {nav.map((item) => (
          <a
            href={u(item.href)}
            class="rounded-lg px-3 py-3 text-lg font-medium text-muted transition-colors hover:bg-panel hover:text-ink"
            data-menu-link
          >
            {item.label}
          </a>
        ))}
      </nav>
      <a href={`mailto:${site.email}`} class="btn btn-primary mt-auto justify-center" data-menu-link>Hire me</a>
    </div>
  </div>
</header>

<script>
  // Motion toggle — an explicit site override of the OS reduced-motion
  // preference. Persisted, then reloaded so the hero and reveals re-init
  // under the new choice.
  const motionButtons = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
  function reflectMotion() {
    const on = document.documentElement.dataset.motion === 'on';
    motionButtons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(on));
      const label = btn.querySelector<HTMLElement>('[data-motion-label]');
      if (label) label.textContent = on ? 'Motion: on' : 'Motion: off';
    });
  }
  reflectMotion();
  motionButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.motion === 'on' ? 'off' : 'on';
      try {
        localStorage.setItem('site-motion', next);
      } catch {}
      document.documentElement.dataset.motion = next;
      window.location.reload();
    })
  );

  // Scrolled state — glass backdrop
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Mobile drawer
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const content = panel?.querySelector<HTMLElement>('[data-menu-content]');
  const overlay = panel?.querySelector<HTMLElement>('[data-menu-overlay]');

  function setMenu(open: boolean) {
    if (!panel || !openBtn || !content || !overlay) return;
    panel.setAttribute('aria-hidden', String(!open));
    panel.classList.toggle('is-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    content.classList.toggle('translate-x-full', !open);
    overlay.classList.toggle('opacity-0', !open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) {
      // Focus after a frame: guaranteed post-style-recalc.
      requestAnimationFrame(() => {
        panel?.querySelector<HTMLElement>('a, button')?.focus();
      });
    } else {
      openBtn.focus();
    }
  }

  openBtn?.addEventListener('click', () => setMenu(true));
  panel?.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
  overlay?.addEventListener('click', () => setMenu(false));
  panel?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.getAttribute('aria-hidden') === 'false') setMenu(false);
  });

  // Scroll-spy — highlight the nav link of the section crossing the viewport's
  // focus band. Computed on scroll (rAF-throttled) rather than IntersectionObserver:
  // sections taller than the band never change intersection state, which would
  // leave a stale highlight while scrolling inside them.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = links
    .map((l) => document.querySelector<HTMLElement>(l.dataset.target ?? ''))
    .filter((s): s is HTMLElement => s !== null);

  if (sections.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const band = window.innerHeight * 0.45;
      let activeId: string | null = null;
      for (const s of sections) {
        const r = s.getBoundingClientRect();
        if (r.top <= band && r.bottom > band) {
          activeId = s.id;
          break;
        }
      }
      for (const l of links) {
        l.setAttribute('aria-current', String(l.dataset.target === `#${activeId}`));
      }
    };
    const onScrollSpy = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScrollSpy, { passive: true });
    window.addEventListener('resize', onScrollSpy, { passive: true });
    update();
  }
</script>
