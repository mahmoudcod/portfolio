---
import { nav, site } from '../lib/site.config';
import { u } from '../lib/urls';
import Icon from './Icon.astro';

/** Strip the configured base path so active-link matching works under /portfolio too. */
const stripBase = (p: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
  const without = base && p.startsWith(base) ? p.slice(base.length) : p;
  return without.replace(/\/+$/, '') || '/';
};

const path = stripBase(Astro.url.pathname);
const isActive = (href: string) => {
  const target = stripBase(u(href).split('#')[0]);
  return target === '/' ? path === '/' : path === target || path.startsWith(target + '/');
};

const initials = site.name
  .split(/\s+/)
  .filter(Boolean)
  .map((w) => w[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md transition-shadow"
  data-scroll-shadow
>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href={u('/')} class="group flex items-baseline gap-2" aria-label={`${site.name} — home`}>
      <span class="font-display text-lg font-extrabold tracking-tight">{initials}</span>
      <span class="hidden sm:block text-sm text-muted group-hover:text-fg transition-colors">
        <span class="font-arabic" lang="ar" dir="rtl">محمود كامل</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
      {
        nav.map((item) => (
          <a
            href={u(item.href)}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-muted hover:text-fg',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-theme-toggle
        class="btn btn-ghost px-2.5 py-2.5"
        aria-label="Toggle light / dark theme"
      >
        <Icon name="sun" class="h-5 w-5 dark:hidden" />
        <Icon name="moon" class="hidden h-5 w-5 dark:block" />
      </button>

      <button
        type="button"
        class="btn btn-ghost px-2.5 py-2.5 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-open
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-50 overflow-hidden md:hidden"
    data-menu-panel
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-black/50 opacity-0 transition-opacity" data-menu-overlay></div>
    <nav
      class="absolute top-0 right-0 h-full w-72 max-w-[85%] translate-x-full border-l border-line bg-surface p-6 shadow-2xl transition-transform duration-200"
      aria-label="Mobile navigation"
      data-menu-content
    >
      <div class="mb-6 flex items-center justify-between">
        <span class="font-arabic text-sm text-muted" lang="ar" dir="rtl">القائمة</span>
        <button type="button" class="btn btn-ghost px-2.5 py-2.5" aria-label="Close menu" data-menu-close>
          <Icon name="x" class="h-5 w-5" />
        </button>
      </div>
      <ul class="space-y-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={u(item.href)}
                class:list={[
                  'block rounded-md px-4 py-3 text-base font-medium',
                  isActive(item.href) ? 'bg-accent-soft text-accent' : 'text-muted hover:bg-surface-2 hover:text-fg',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                data-menu-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 border-t border-line pt-6">
        <a href={`mailto:${site.email}`} class="flex items-center gap-2 px-4 py-2 text-sm text-muted">
          <Icon name="mail" class="h-4 w-4" /> {site.email}
        </a>
      </div>
    </nav>
  </div>
</header>
