---
import { site } from '../lib/site.config';
import { u } from '../lib/urls';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-site flex flex-col items-center gap-6 py-10 text-center sm:flex-row sm:justify-between sm:text-start">
    <div>
      <p class="font-arabic text-left text-lg text-cyan" lang="ar" dir="rtl" aria-hidden="true">{site.nameAr}</p>
      <p class="mt-1 text-sm text-muted">
        © {year} {site.name} · {site.location} · {site.availability}
      </p>
    </div>
    <nav class="flex items-center gap-5 text-sm" aria-label="Social">
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="nav-link">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="nav-link">LinkedIn</a>
      <a href={u(site.resumePath)} class="nav-link">Résumé</a>
      <a href={`mailto:${site.email}`} class="nav-link">Email</a>
    </nav>
  </div>
</footer>
