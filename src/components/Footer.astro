---
import { site } from '../lib/site.config';
import Icon from './Icon.astro';
import { u } from '../lib/urls';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-site flex flex-col items-start justify-between gap-6 py-12 sm:flex-row sm:items-center">
    <div>
      <p class="font-display text-lg font-bold">{site.name}</p>
      <p class="mt-1 text-sm text-muted">
        © {year} · Built with
        <a href="https://astro.build" class="hover:text-accent transition-colors" rel="noopener noreferrer" target="_blank">Astro</a>
        and Tailwind CSS. Stats pulled live from the GitHub API.
      </p>
    </div>
    <ul class="flex items-center gap-1" aria-label="Social links">
      <li>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-2.5 py-2.5" aria-label="GitHub profile">
          <Icon name="github" class="h-5 w-5" />
        </a>
      </li>
      <li>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-2.5 py-2.5" aria-label="LinkedIn profile">
          <Icon name="linkedin" class="h-5 w-5" />
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} class="btn btn-ghost px-2.5 py-2.5" aria-label="Send email">
          <Icon name="mail" class="h-5 w-5" />
        </a>
      </li>
    </ul>
  </div>
</footer>
