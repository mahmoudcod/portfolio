---
import Icon from './Icon.astro';

interface Props {
  video: { type: 'youtube' | 'loom' | 'mp4' | 'gif'; src: string; title?: string };
}

const { video } = Astro.props;
const title = video.title ?? 'Project demo video';

let embed: { kind: 'iframe'; src: string } | { kind: 'video'; src: string } | { kind: 'gif'; src: string } | null = null;

if (video.type === 'youtube') {
  const id = video.src.match(/(?:youtu\.be\/|[?&]v=|embed\/)([\w-]{11})/)?.[1] ?? video.src;
  embed = { kind: 'iframe', src: `https://www.youtube-nocookie.com/embed/${id}?rel=0` };
} else if (video.type === 'loom') {
  const id = video.src.includes('/share/') ? video.src.split('/share/')[1]?.split(/[?#]/)[0] : video.src;
  embed = { kind: 'iframe', src: `https://www.loom.com/embed/${id}` };
} else if (video.type === 'mp4') {
  embed = { kind: 'video', src: video.src };
} else {
  embed = { kind: 'gif', src: video.src };
}
---

<figure>
  <div class="relative mx-auto aspect-video w-full overflow-hidden rounded-xl border border-line bg-surface shadow-lg">
    {
      embed?.kind === 'iframe' && (
        <iframe
          src={embed.src}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          class="absolute inset-0 h-full w-full"
        />
      )
    }
    {
      embed?.kind === 'video' && (
        <video src={embed.src} controls preload="metadata" class="absolute inset-0 h-full w-full">
          <track kind="captions" />
          Your browser does not support the video tag.
        </video>
      )
    }
    {
      embed?.kind === 'gif' && <img src={embed.src} alt={title} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-contain" />
    }
  </div>
  <figcaption class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-muted">
    <Icon name="play" class="h-3.5 w-3.5" /> {title}
  </figcaption>
</figure>
