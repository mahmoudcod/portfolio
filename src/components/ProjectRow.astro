---
import { u } from '../lib/urls';
import { formatMonthYear } from '../lib/format';
import StatusPill from './StatusPill.astro';
import TechBadges from './TechBadges.astro';
import Icon from './Icon.astro';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Sequence position (1-based) — shown as the row number. */
  n: number;
}

const { project, n } = Astro.props;
const { data, repo } = project;
const detailHref = u(`/projects/${project.slug}`);
const year = data.date ? String(data.date.getFullYear()) : repo?.pushed_at ? String(new Date(repo.pushed_at).getFullYear()) : '';
const search = [data.title, data.summary, data.category, ...data.tech, ...(repo?.topics ?? [])].join(' ').toLowerCase();
const num = String(n).padStart(2, '0');
---

<li
  class="index-row group"
  data-project-card
  data-title={data.title.toLowerCase()}
  data-search={search}
  data-category={data.category.toLowerCase()}
  data-tech={data.tech.map((t) => t.toLowerCase()).join('|')}
  data-stars={repo?.stargazers_count ?? 0}
  data-date={repo?.pushed_at ?? data.date?.toISOString() ?? ''}
  data-order={data.order}
  data-preview={project.cover.src}
>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-x-6 gap-y-3 p-5 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:p-6">
    <span class="index-num text-sm sm:pt-2.5" aria-hidden="true">{num}</span>

    <div class="min-w-0">
      <h3 class="index-title text-2xl font-bold sm:text-3xl">
        <a href={detailHref} class="after:absolute after:inset-0">
          {data.title}
        </a>
      </h3>
      <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted sm:text-[0.95rem]">{data.summary}</p>
      <div class="mt-3">
        <TechBadges tech={data.tech} max={4} />
      </div>
    </div>

    <div class="flex min-w-0 flex-row flex-wrap items-center gap-4 sm:w-44 sm:flex-col sm:flex-nowrap sm:items-end sm:gap-2 sm:pt-1.5">
      <div class="flex items-center gap-3 sm:flex-col sm:items-end sm:gap-1.5">
        <span class="text-xs font-medium text-muted">{data.category}</span>
        {year && <span class="index-num text-xs">{year}</span>}
        <StatusPill status={data.status} />
      </div>
      <div class="relative z-10 flex items-center gap-1 sm:mt-2">
        {
          project.demoUrl && (
            <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-2 py-1.5 text-xs" aria-label={`${data.title} — open live demo`}>
              <Icon name="external" class="h-4 w-4" /> Demo
            </a>
          )
        }
        {
          project.githubUrl && (
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-2 py-1.5 text-xs" aria-label={`${data.title} — GitHub repository`}>
              <Icon name="github" class="h-4 w-4" /> Code
            </a>
          )
        }
        {repo && repo.stargazers_count > 0 && (
          <span class="ms-1 hidden items-center gap-1 text-xs text-muted sm:inline-flex">
            <Icon name="star" class="h-3.5 w-3.5" /> {repo.stargazers_count}
          </span>
        )}
        <span class="sr-only">
          {repo ? `Updated ${formatMonthYear(repo.pushed_at)}` : ''}
        </span>
      </div>
    </div>
  </div>
</li>

<script>
  // Floating screenshot preview for index rows (fine pointers only).
  const fine = window.matchMedia('(pointer: fine)').matches;
  if (fine) {
    const preview = document.createElement('div');
    preview.className = 'work-preview';
    const img = document.createElement('img');
    img.alt = '';
    img.loading = 'lazy';
    img.decoding = 'async';
    preview.appendChild(img);
    document.body.appendChild(preview);

    const rows = document.querySelectorAll<HTMLElement>('[data-preview]');
    let visible = false;

    const show = (src: string) => {
      if (img.getAttribute('src') !== src) img.src = src;
      preview.classList.add('on');
      visible = true;
    };
    const hide = () => {
      preview.classList.remove('on');
      visible = false;
    };
    const move = (e: MouseEvent) => {
      if (!visible) return;
      preview.style.left = `${e.clientX}px`;
      preview.style.top = `${e.clientY - 40}px`;
    };

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => show(row.dataset.preview ?? ''));
      row.addEventListener('mouseleave', hide);
    });
    window.addEventListener('mousemove', move, { passive: true });
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>
