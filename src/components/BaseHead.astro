---
import { site } from '../lib/site.config';
import { u } from '../lib/urls';
import { buildOgSvg, renderOgPng } from '../lib/og';

interface Props {
  title: string;
  description: string;
  /** Path to a pre-generated OG image (e.g. /og/projects/taskflow.png). */
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, ogImage = '/og/default.png', type = 'website', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(u(ogImage), Astro.site);
const fullTitle = title.includes(site.name.replace(/[\[\]]/g, '')) ? title : `${title} · ${site.name.replace(/[\[\]]/g, '')}`;
---

<!-- Primary meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />
<meta name="author" content={site.name.replace(/[\[\]]/g, '')} />
<meta name="theme-color" content="#0c211d" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#efede4" media="(prefers-color-scheme: light)" />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name.replace(/[\[\]]/g, '')} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- JSON-LD: Person -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name.replace(/[\[\]]/g, ''),
  jobTitle: site.title.replace(/[\[\]]/g, ''),
  description: site.bio.replace(/[\[\]]/g, ''),
  url: String(canonical),
  email: `mailto:${site.email.replace(/[\[\]]/g, '')}`,
  sameAs: [site.github.replace(/[\[\]]/g, ''), site.linkedin.replace(/[\[\]]/g, '')],
  address: { '@type': 'PostalAddress', addressCountry: 'EG' },
})} />

