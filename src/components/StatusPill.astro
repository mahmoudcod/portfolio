---
interface Props {
  status: 'active' | 'maintained' | 'wip' | 'archived';
}
const { status } = Astro.props;
const labels: Record<Props['status'], string> = {
  active: 'In production',
  maintained: 'Maintained',
  wip: 'In progress',
  archived: 'Archived',
};
const dotColor: Record<Props['status'], string> = {
  active: 'var(--support)',
  maintained: 'var(--accent)',
  wip: '#d97706',
  archived: 'var(--muted)',
};
---

<span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted">
  <span class="h-1.5 w-1.5 rounded-full" style={`background:${dotColor[status]}`} aria-hidden="true"></span>
  {labels[status]}
</span>
