---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, skills, timeline } from '../lib/site.config';
import { u } from '../lib/urls';

const displayName = site.name;
const description = `About ${displayName} — ${site.title} from ${site.location}. Skills, story and experience.`;
---

<BaseLayout title="About" description={description}>
  <section class="py-14 sm:py-20">
    <div class="container-site">
      <div class="grid items-start gap-10 lg:grid-cols-[320px_minmax(0,1fr)]">
        <div>
          <img
            src={u('/avatar.svg')}
            alt={`Portrait placeholder for ${displayName}`}
            width="800"
            height="800"
            class="aspect-square w-full max-w-[320px] rounded-lg border border-line object-cover"
            loading="eager"
            decoding="async"
          />
          <ul class="mt-6 space-y-2.5 text-sm text-muted">
            <li class="flex items-center gap-2"><Icon name="map-pin" class="h-4 w-4 text-accent" /> {site.location}</li>
            <li class="flex items-center gap-2">
              <Icon name="github" class="h-4 w-4 text-accent" />
              <a href={site.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="linkedin" class="h-4 w-4 text-accent" />
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="mail" class="h-4 w-4 text-accent" />
              <a href={`mailto:${site.email}`} class="hover:text-accent transition-colors">Email</a>
            </li>
          </ul>
        </div>

        <div>
          <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">نبذة عني</p>
          <h1 class="font-display mt-1 text-4xl font-extrabold tracking-tight sm:text-6xl">Hey, I'm {displayName}</h1>
          <div class="mt-6 max-w-2xl space-y-4 leading-relaxed text-muted">
            <p class="text-lg text-fg">{site.bio}</p>
            <p>
              Most of my work serves Arabic-speaking users first: a hospital operations tracker running on clinic
              machines, a bilingual e-commerce platform, an Arabic-first warehouse system in production, and an
              educational game for kids — all built RTL-native, not translated as an afterthought. I ship complete
              products: the UI, the API behind it, the database, and the deployment pipeline.
            </p>
            <p>
              I work across the stack — React, Next.js and Vue on the web; Electron and Tauri on the desktop;
              Node.js, Express and Strapi on the server; MongoDB, PostgreSQL and SQLite underneath. Lately I have
              been hardening APIs for production (rate limiting, auth, backups) and deploying full systems to
              Render and Cloudflare. Open to remote roles and freelance work.
            </p>
          </div>

          <h2 class="font-display mt-14 text-2xl font-bold tracking-tight sm:text-3xl">Skills by area</h2>
          <dl class="mt-6 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              skills.map((group) => (
                <div>
                  <dt class="text-sm font-semibold text-fg">{group.area}</dt>
                  <dd class="mt-3 flex flex-wrap gap-1.5">
                    {group.items.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            timeline.length > 0 && (
              <>
                <h2 class="font-display mt-14 text-2xl font-bold tracking-tight sm:text-3xl">Experience</h2>
                <ol class="mt-6 list-none border-t border-line">
                  {timeline.map((item) => (
                    <li class="grid gap-1 border-b border-line py-5 sm:grid-cols-[160px_minmax(0,1fr)] sm:gap-6">
                      <span class="text-sm font-medium text-accent">{item.period}</span>
                      <div>
                        <h3 class="font-semibold">
                          {item.role} <span class="font-normal text-muted">· {item.org}</span>
                        </h3>
                        <p class="mt-1 text-sm text-muted">{item.note}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </>
            )
          }

          <a href={u(site.resumePath)} download class="btn btn-primary mt-12">
            <Icon name="download" class="h-4 w-4" /> Download resume (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
