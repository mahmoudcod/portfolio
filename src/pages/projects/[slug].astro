---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import StatusPill from '../../components/StatusPill.astro';
import TechBadges from '../../components/TechBadges.astro';
import Gallery from '../../components/Gallery.astro';
import DemoVideo from '../../components/DemoVideo.astro';
import Icon from '../../components/Icon.astro';
import { getPortfolio, getNeighbors } from '../../lib/projects';
import { fetchReadmeHtml } from '../../lib/github';
import { formatStars, formatDate } from '../../lib/format';
import { u } from '../../lib/urls';
import { site } from '../../lib/site.config';

export async function getStaticPaths() {
  const { projects } = await getPortfolio();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, all: projects },
  }));
}

const { project, all } = Astro.props;
const { data, repo } = project;

const neighbors = getNeighbors(all, project.slug);
const readmeHtml = await fetchReadmeHtml(data.repo, data.readme, data.privateRepo);

const title = `${data.title} — case study`;
const description = `${data.summary} A project by ${site.name}.`;
---

<BaseLayout title={title} description={description} ogImage={`/og/projects/${project.slug}.png`} type="article">
  <article>
    <!-- Hero -->
    <header class="border-b border-line bg-surface">
      <div class="container-site py-12 sm:py-16">
        <p class="text-sm text-muted">
          <a href={u('/projects')} class="hover:text-accent transition-colors">Project index</a>
          <span aria-hidden="true"> — </span>
          <span class="text-fg">{data.title}</span>
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
          <span class="font-medium text-fg">{data.category}</span>
          <StatusPill status={data.status} />
          {
            data.date && <span>{formatDate(data.date)}</span>
          }
        </div>

        <h1 class="font-display mt-4 max-w-4xl text-[clamp(2.2rem,5.5vw,4.25rem)] font-extrabold leading-[1.02]">
          {data.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-muted">{data.summary}</p>

        <div class="mt-6 max-w-2xl">
          <TechBadges tech={data.tech} />
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          {
            project.demoUrl && (
              <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                <Icon name="external" class="h-4 w-4" /> Open the live demo
              </a>
            )
          }
          {
            project.githubUrl && (
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <Icon name="github" class="h-4 w-4" /> View source
              </a>
            )
          }
        </div>

        {
          repo && (
            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-muted">
              <li>{formatStars(repo.stargazers_count)} stars</li>
              <li>{formatStars(repo.forks_count)} forks</li>
              {repo.language && <li>{repo.language}</li>}
              <li>Updated {formatDate(repo.pushed_at)}</li>
            </ul>
          )
        }
      </div>
    </header>

    <div class="container-site py-12">
      <!-- Cover -->
      <BrowserFrame url={project.demoUrl ? new URL(project.demoUrl).host : `${project.slug}.app`} class="-mt-2 mb-14">
        <img
          src={project.cover.src}
          alt={`${data.title} cover screenshot`}
          width={project.cover.width}
          height={project.cover.height}
          class="aspect-[16/10] w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </BrowserFrame>

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="min-w-0 space-y-14">
          <!-- Demo video -->
          {
            data.video && (
              <section aria-labelledby="demo-heading">
                <h2 id="demo-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Demo</h2>
                <div class="mt-5">
                  <DemoVideo video={data.video} />
                </div>
              </section>
            )
          }

          <!-- Overview -->
          <section aria-labelledby="overview-heading">
            <h2 id="overview-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Overview</h2>
            <p class="mt-4 leading-relaxed text-muted">{data.description}</p>
            <div class="mt-6 border-t border-line">
              {
                [
                  { label: 'The problem', text: data.overview.problem },
                  { label: 'What I built', text: data.overview.solution },
                  { label: 'The result', text: data.overview.result },
                ].map((row) => (
                  <div class="grid gap-1 border-b border-line py-5 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-6">
                    <h3 class="text-sm font-semibold text-accent">{row.label}</h3>
                    <p class="text-sm leading-relaxed sm:text-[0.95rem]">{row.text}</p>
                  </div>
                ))
              }
            </div>
          </section>

          <!-- Key features -->
          {
            data.features.length > 0 && (
              <section aria-labelledby="features-heading">
                <h2 id="features-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">What it does</h2>
                <ul class="mt-5 list-none border-t border-line">
                  {data.features.map((f) => (
                    <li class="flex items-start gap-3 border-b border-line py-3.5 text-sm leading-relaxed sm:text-[0.95rem]">
                      <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <!-- How it works -->
          {
            data.howItWorks.length > 0 && (
              <section aria-labelledby="how-heading">
                <h2 id="how-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">How it works</h2>
                <ol class="mt-6 list-none border-t border-line">
                  {data.howItWorks.map((step, i) => (
                    <li class="grid gap-1 border-b border-line py-5 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-4">
                      <span class="font-display font-bold text-accent" aria-hidden="true">{i + 1}</span>
                      <div>
                        <h3 class="font-semibold">{step.title}</h3>
                        <p class="mt-1 text-sm leading-relaxed text-muted">{step.description}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          <!-- Challenges & lessons -->
          {
            (data.challenges.length > 0 || data.lessons.length > 0) && (
              <section aria-labelledby="challenges-heading">
                <h2 id="challenges-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
                  Challenges & lessons
                </h2>
                {data.challenges.length > 0 && (
                  <div class="mt-5 grid gap-4 sm:grid-cols-2">
                    {data.challenges.map((c) => (
                      <div class="border border-line p-5">
                        <h3 class="text-sm font-semibold leading-snug">{c.challenge}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-muted">{c.resolution}</p>
                      </div>
                    ))}
                  </div>
                )}
                {data.lessons.length > 0 && (
                  <ul class="mt-5 list-none space-y-2.5">
                    {data.lessons.map((l) => (
                      <li class="flex items-start gap-3 text-sm leading-relaxed sm:text-[0.95rem]">
                        <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                        {l}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            )
          }

          <!-- README -->
          {
            readmeHtml && (
              <section aria-labelledby="readme-heading">
                <h2 id="readme-heading" class="font-display text-2xl font-bold tracking-tight sm:text-3xl">From the README</h2>
                <p class="mt-2 text-xs text-muted">
                  {data.privateRepo ? 'From the project README.' : `Rendered from ${data.repo} at build time.`}
                </p>
                <div class="readme mt-5 border border-line p-6" set:html={readmeHtml} />
              </section>
            )
          }
        </div>

        <!-- Sidebar -->
        <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start" aria-label="Project facts">
          <div class="border border-line p-5">
            <h2 class="text-sm font-semibold">Tech stack</h2>
            <div class="mt-3">
              <TechBadges tech={data.tech} />
            </div>
          </div>
          {
            repo?.topics && repo.topics.length > 0 && (
              <div class="border border-line p-5">
                <h2 class="text-sm font-semibold">GitHub topics</h2>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {repo.topics.slice(0, 10).map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            )
          }
          <div class="border border-line p-5">
            <h2 class="text-sm font-semibold">Links</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {
                project.demoUrl && (
                  <li>
                    <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                      Live demo
                    </a>
                  </li>
                )
              }
              {
                project.githubUrl && (
                  <li>
                    <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                      Source code
                    </a>
                  </li>
                )
              }
              <li>
                <a href={`mailto:${site.email}?subject=Feedback on ${data.title}`} class="text-accent hover:underline">
                  Send feedback
                </a>
              </li>
            </ul>
          </div>
        </aside>
      </div>

      <!-- Gallery -->
      {
        data.gallery.length > 0 && (
          <div class="mt-14 border-t border-line pt-12">
            <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Screenshots</h2>
            <p class="mt-2 text-sm text-muted">Click any screenshot to open the lightbox. Desktop shots use a browser frame, mobile shots a phone frame.</p>
            <div class="mt-6">
              <Gallery images={project.gallery} projectTitle={data.title} />
            </div>
          </div>
        )
      }

      <!-- Prev / next -->
      <nav class="mt-14 grid gap-4 border-t border-line pt-10 sm:grid-cols-2" aria-label="Project navigation">
        {
          neighbors.prev ? (
            <a href={u(`/projects/${neighbors.prev.slug}`)} class="group border border-line p-5 transition-colors hover:border-accent">
              <p class="text-xs text-muted">Previous</p>
              <p class="font-display mt-1.5 font-bold group-hover:text-accent transition-colors">{neighbors.prev.data.title}</p>
            </a>
          ) : (
            <span />
          )
        }
        {
          neighbors.next && (
            <a href={u(`/projects/${neighbors.next.slug}`)} class="group border border-line p-5 text-right transition-colors hover:border-accent">
              <p class="text-xs text-muted">Next</p>
              <p class="font-display mt-1.5 font-bold group-hover:text-accent transition-colors">{neighbors.next.data.title}</p>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>
