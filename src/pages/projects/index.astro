---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import Icon from '../../components/Icon.astro';
import { getPortfolio } from '../../lib/projects';
import { formatStars, formatMonthYear } from '../../lib/format';
import { site } from '../../lib/site.config';

const { projects, moreRepos } = await getPortfolio();

const categories = [...new Set(projects.map((p) => p.data.category))].sort();
const techCounts = new Map<string, number>();
for (const p of projects) for (const t of p.data.tech) techCounts.set(t, (techCounts.get(t) ?? 0) + 1);
const techs = [...techCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14).map(([t]) => t);

const displayName = site.name;
const description = `Browse ${displayName}'s projects — filter by technology and category, sort by stars or recency, and open full case studies.`;
---

<BaseLayout title="Projects" description={description}>
  <section class="py-14 sm:py-20">
    <div class="container-site">
      <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">فهرس المشاريع</p>
      <h1 class="font-display mt-1 text-4xl font-extrabold tracking-tight sm:text-6xl">Project index</h1>
      <p class="mt-4 max-w-2xl text-muted">
        {projects.length} case studies{moreRepos.length ? `, plus ${moreRepos.length} smaller repos picked up live from GitHub` : ''}.
        Search, filter and sort — every row opens a full write-up.
      </p>

      <!-- Toolbar -->
      <div class="mt-10 border border-line p-4 sm:p-5" role="search" aria-label="Filter projects">
        <div class="flex flex-col gap-3 sm:flex-row">
          <label class="relative flex-1">
            <span class="sr-only">Search projects</span>
            <Icon name="search" class="pointer-events-none absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-muted" />
            <input
              type="search"
              placeholder="Search projects, tech, topics…"
              data-filter="search"
              class="w-full rounded-md border border-line bg-bg py-2.5 pr-3 pl-10 text-sm placeholder:text-muted/70 focus:border-accent focus:outline-none"
            />
          </label>
          <label class="sm:w-52">
            <span class="sr-only">Sort projects</span>
            <select
              data-filter="sort"
              class="w-full rounded-md border border-line bg-bg px-3 py-2.5 text-sm focus:border-accent focus:outline-none"
            >
              <option value="order">Curated order</option>
              <option value="date">Recently updated</option>
              <option value="stars">Most stars</option>
              <option value="title">A–Z</option>
            </select>
          </label>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button
            type="button"
            class="tag data-[active]:border-accent data-[active]:text-accent"
            data-filter="category"
            data-value="all"
            data-active="true"
            aria-pressed="true"
          >
            All categories
          </button>
          {
            categories.map((c) => (
              <button
                type="button"
                class="tag data-[active]:border-accent data-[active]:text-accent"
                data-filter="category"
                data-value={c}
                aria-pressed="false"
              >
                {c}
              </button>
            ))
          }
        </div>

        {
          techs.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <span class="text-xs text-muted">Tech:</span>
              {techs.map((t) => (
                <label class="tag cursor-pointer select-none has-[:checked]:border-accent has-[:checked]:text-accent">
                  <input type="checkbox" class="accent-accent" data-filter="tech" value={t.toLowerCase()} />
                  {t}
                </label>
              ))}
            </div>
          )
        }

        <p class="mt-4 text-xs text-muted" data-filter-count aria-live="polite"></p>
      </div>

      <!-- Index -->
      <ul id="project-grid" class="mt-10 list-none" data-work-index>
        {projects.map((project, i) => <ProjectRow project={project} n={i + 1} />)}
      </ul>

      <p data-filter-empty class="hidden py-16 text-center text-muted">
        Nothing matches those filters — try clearing the search or unchecking a few technologies.
      </p>
    </div>
  </section>

  <!-- More on GitHub -->
  {
    moreRepos.length > 0 && (
      <section class="border-t border-line bg-surface py-16">
        <div class="container-site">
          <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">على غيت هاب</p>
          <h2 class="font-display mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">Also on GitHub</h2>
          <p class="mt-3 max-w-2xl text-muted">
            Smaller experiments and utilities, generated automatically from my GitHub profile on every build.
          </p>
          <ul class="mt-8 list-none">
            {moreRepos.map((repo) => (
              <li class="border-t border-line last:border-b">
                <a
                  href={repo.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group grid gap-x-6 gap-y-1 p-4 transition-colors hover:bg-bg sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5"
                >
                  <div class="min-w-0">
                    <p class="font-display font-bold group-hover:text-accent transition-colors">{repo.name}</p>
                    <p class="mt-0.5 text-sm text-muted">{repo.description ?? 'No description provided.'}</p>
                  </div>
                  <div class="flex items-center gap-4 text-xs text-muted sm:justify-end">
                    {repo.language && <span>{repo.language}</span>}
                    {repo.stargazers_count > 0 && (
                      <span class="flex items-center gap-1">
                        <Icon name="star" class="h-3.5 w-3.5" /> {formatStars(repo.stargazers_count)}
                      </span>
                    )}
                    <span>{formatMonthYear(repo.pushed_at)}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8">
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Everything on GitHub
            </a>
          </div>
        </div>
      </section>
    )
  }

  <script>
    // Client-side search / filter / sort over server-rendered rows.
    const grid = document.getElementById('project-grid');
    const cards = grid ? [...grid.querySelectorAll<HTMLElement>('[data-project-card]')] : [];
    const searchInput = document.querySelector<HTMLInputElement>('[data-filter="search"]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-filter="sort"]');
    const categoryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter="category"]')];
    const techChecks = [...document.querySelectorAll<HTMLInputElement>('[data-filter="tech"]')];
    const countEl = document.querySelector<HTMLElement>('[data-filter-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-filter-empty]');

    const params = new URLSearchParams(location.search);
    if (params.get('q') && searchInput) searchInput.value = params.get('q') ?? '';
    if (params.get('cat')) {
      const btn = categoryButtons.find((b) => b.dataset.value === params.get('cat'));
      if (btn) btn.click();
    }
    for (const t of params.getAll('tech')) {
      const box = techChecks.find((c) => c.value === t.toLowerCase());
      if (box) box.checked = true;
    }
    if (params.get('sort') && sortSelect) sortSelect.value = params.get('sort') ?? 'order';

    function activeCategory() {
      return categoryButtons.find((b) => b.dataset.active === 'true')?.dataset.value ?? 'all';
    }

    function syncUrl() {
      const p = new URLSearchParams();
      const q = searchInput?.value.trim();
      const cat = activeCategory();
      const tech = techChecks.filter((c) => c.checked).map((c) => c.value);
      const sort = sortSelect?.value ?? 'order';
      if (q) p.set('q', q);
      if (cat !== 'all') p.set('cat', cat);
      for (const t of tech) p.append('tech', t);
      if (sort !== 'order') p.set('sort', sort);
      history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
    }

    function apply() {
      const q = (searchInput?.value ?? '').trim().toLowerCase();
      const cat = activeCategory().toLowerCase();
      const needTech = techChecks.filter((c) => c.checked).map((c) => c.value);
      let visible = 0;

      for (const card of cards) {
        const matchQ = !q || (card.dataset.search ?? '').includes(q);
        const matchCat = cat === 'all' || card.dataset.category === cat;
        const cardTech = (card.dataset.tech ?? '').split('|');
        const matchTech = needTech.every((t) => cardTech.includes(t));
        const show = matchQ && matchCat && matchTech;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      const sort = sortSelect?.value ?? 'order';
      const sorted = [...cards].sort((a, b) => {
        switch (sort) {
          case 'date':
            return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
          case 'stars':
            return Number(b.dataset.stars ?? 0) - Number(a.dataset.stars ?? 0);
          case 'title':
            return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
          default:
            return Number(a.dataset.order ?? 999) - Number(b.dataset.order ?? 999);
        }
      });
      for (const card of sorted) grid?.appendChild(card);

      if (countEl) countEl.textContent = `Showing ${visible} of ${cards.length} projects`;
      emptyEl?.classList.toggle('hidden', visible > 0);
      syncUrl();
    }

    searchInput?.addEventListener('input', apply);
    sortSelect?.addEventListener('change', apply);
    categoryButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        categoryButtons.forEach((b) => {
          const active = b === btn;
          b.dataset.active = String(active);
          b.setAttribute('aria-pressed', String(active));
        });
        apply();
      })
    );
    techChecks.forEach((c) => c.addEventListener('change', apply));

    apply();
  </script>
</BaseLayout>
