---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site.config';
import { u } from '../lib/urls';

const displayName = site.name.replace(/[\[\]]/g, '');
const description = `Contact ${displayName} — ${site.title.replace(/[\[\]]/g, '')}. Email, social links and a contact form. Open to remote work.`;
const formspreeReady = site.formspreeId && site.formspreeId !== 'YOUR_FORM_ID';
---

<BaseLayout title="Contact" description={description}>
  <section class="py-14">
    <div class="container-site grid items-start gap-12 lg:grid-cols-2">
      <div data-reveal>
        <SectionHeading
          eyebrow="Contact"
          title="Let's work together"
          description="Have a project, a role, or just a question? My inbox is open — I usually reply within a day."
        />

        <ul class="space-y-4">
          <li>
            <a href={`mailto:${site.email}`} class="card card-hover flex items-center gap-4 p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name="mail" class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-semibold">Email</span>
                <span class="block font-mono text-sm text-muted">{site.email}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="card card-hover flex items-center gap-4 p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name="github" class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-semibold">GitHub</span>
                <span class="block font-mono text-sm text-muted">github.com/{site.githubUsername}</span>
              </span>
            </a>
          </li>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="card card-hover flex items-center gap-4 p-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name="linkedin" class="h-5 w-5" />
              </span>
              <span>
                <span class="block font-semibold">LinkedIn</span>
                <span class="block font-mono text-sm text-muted">Connect with me</span>
              </span>
            </a>
          </li>
        </ul>

        <a href={u(site.resumePath)} download class="btn btn-secondary mt-8">
          <Icon name="download" class="h-4 w-4" /> Download resume (PDF)
        </a>
      </div>

      <div class="card p-6 sm:p-8" data-reveal>
        {
          formspreeReady ? (
            <form action={`https://formspree.io/f/${site.formspreeId}`} method="POST" class="space-y-5">
              <div class="grid gap-5 sm:grid-cols-2">
                <label class="block">
                  <span class="mb-1.5 block text-sm font-medium">Name</span>
                  <input
                    type="text"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full rounded-lg border border-line bg-bg px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
                  />
                </label>
                <label class="block">
                  <span class="mb-1.5 block text-sm font-medium">Email</span>
                  <input
                    type="email"
                    name="email"
                    required
                    autocomplete="email"
                    class="w-full rounded-lg border border-line bg-bg px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
                  />
                </label>
              </div>
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Message</span>
                <textarea
                  name="message"
                  rows="6"
                  required
                  class="w-full rounded-lg border border-line bg-bg px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"
                />
              </label>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
              <button type="submit" class="btn btn-primary w-full">
                <Icon name="send" class="h-4 w-4" /> Send message
              </button>
            </form>
          ) : (
            <div class="space-y-4">
              <h2 class="text-xl font-bold">The form needs one setup step</h2>
              <p class="text-sm leading-relaxed text-muted">
                This form sends messages via <a href="https://formspree.io" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Formspree</a>
                (free tier is fine). To enable it:
              </p>
              <ol class="list-decimal space-y-2 pl-5 text-sm text-muted">
                <li>Create a form at formspree.io and copy its id (looks like <code class="font-mono text-fg">xyzabcd</code>).</li>
                <li>
                  Paste it into <code class="font-mono text-fg">src/lib/site.config.ts</code> → <code class="font-mono text-fg">formspreeId</code>.
                </li>
              </ol>
              <p class="text-sm text-muted">
                Until then, <a href={`mailto:${site.email}`} class="text-accent hover:underline">email me directly</a> — same effect.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
