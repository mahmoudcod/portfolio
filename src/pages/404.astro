---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/urls';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="container-site flex flex-col items-center py-32 text-center">
    <p class="font-display text-7xl font-bold text-gradient glow-cyan sm:text-8xl">404</p>
    <h1 class="font-display mt-6 text-2xl font-semibold sm:text-3xl">Lost in orbit</h1>
    <p class="mt-3 max-w-md text-muted">The link may be broken, or the page may have drifted off the map. Let's get you back to solid ground.</p>
    <div class="mt-9 flex gap-3">
      <a href={u('/')} class="btn btn-primary">Back home</a>
      <a href={u('/#work')} class="btn btn-ghost">See the work</a>
    </div>
  </section>
</BaseLayout>
