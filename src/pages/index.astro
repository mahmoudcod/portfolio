---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillsMarquee from '../components/SkillsMarquee.astro';
import { site, skills } from '../lib/site.config';
import { projectList } from '../lib/projects';
import { u } from '../lib/urls';

const description = `${site.tagline} ${site.name} — ${site.title} based in ${site.location}.`;
---

<BaseLayout title={`${site.name} — ${site.title}`} description={description}>
  <Hero />

  <!-- Selected work: five numbered stations on one orbital rail -->
  <section id="work" class="relative" aria-label="Selected work">
    <div class="container-site pt-20 sm:pt-28">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="font-arabic text-left text-lg text-cyan" lang="ar" dir="rtl" aria-hidden="true">أعمال مختارة</p>
          <h2 class="font-display mt-1 text-3xl font-bold tracking-tight sm:text-5xl">Selected work</h2>
        </div>
        <p class="max-w-sm text-sm leading-relaxed text-muted">
          Five products, every one bilingual AR/EN. Each station has a full walkthrough video, stills and the story of what it does.
        </p>
      </div>
      <hr class="rule-fade mt-10" />
    </div>

    <!-- Center rail (desktop) -->
    <div class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-gradient-to-b from-transparent via-line to-transparent lg:block" aria-hidden="true"></div>

    <div class="container-site divide-line/0 flex flex-col">
      {projectList.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>

  <!-- Stack marquee -->
  <SkillsMarquee />

  <!-- About -->
  <section id="about" class="py-20 sm:py-28" aria-label="About">
    <div class="container-site grid items-start gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <div data-reveal>
        <p class="font-arabic text-left text-lg text-cyan" lang="ar" dir="rtl" aria-hidden="true">نبذة</p>
        <h2 class="font-display mt-1 text-3xl font-bold tracking-tight sm:text-5xl">A little about me</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{site.bio}</p>

        <dl class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
          {
            skills.map((group) => (
              <div>
                <dt class="font-mono-label text-violet">{group.area}</dt>
                <dd class="mt-3 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="tag">{item}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:mt-16" data-reveal style="--reveal-delay: 120ms">
        <div class="stat-card">
          <p class="font-display text-4xl font-bold text-gradient">{projectList.length}</p>
          <p class="mt-1 text-sm text-muted">products shipped end-to-end</p>
        </div>
        <div class="stat-card">
          <p class="font-display text-4xl font-bold text-gradient">AR / EN</p>
          <p class="mt-1 text-sm text-muted">every product, both languages</p>
        </div>
        <div class="stat-card sm:col-span-2">
          <p class="font-mono-label text-violet">Currently</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            {site.availability} — desktop, web and everything in between. The fastest way in is email.
          </p>
          <a href={u(site.resumePath)} class="link-chip mt-4" target="_blank">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M4 1.5h5.5L13 5v9.5H4V1.5Z"></path>
              <path d="M9.5 1.5V5H13M6 8h4M6 10.5h4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            Résumé (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="pb-24 sm:pb-32" aria-label="Contact">
    <div class="container-site">
      <div class="glass relative overflow-hidden rounded-3xl px-6 py-16 text-center sm:px-12 sm:py-20" data-reveal>
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan to-transparent" aria-hidden="true"></div>
        <p class="font-arabic text-lg text-cyan" lang="ar" dir="rtl" aria-hidden="true">تواصل</p>
        <h2 class="font-display mx-auto mt-2 max-w-3xl text-3xl font-bold tracking-tight sm:text-5xl">
          Have something worth building?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-muted">
          I'm open to remote work and interesting collaborations — bilingual products a specialty. Email gets the fastest reply.
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">Say hello</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
        </div>
        <p class="mt-8 font-mono text-sm text-muted">{site.email}</p>
      </div>
    </div>
  </section>
</BaseLayout>
