---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Icon from '../components/Icon.astro';
import { getPortfolio, getFeatured } from '../lib/projects';
import { site, skills } from '../lib/site.config';
import { u } from '../lib/urls';

const { projects } = await getPortfolio();
const featured = getFeatured(projects);
const featuredStart = projects.findIndex((p) => p === featured[0]);

const displayName = site.name;
const jobTitle = site.title;
const description = `${site.tagline} ${displayName} — ${jobTitle} based in ${site.location}.`;
---

<BaseLayout title={`${displayName} — ${jobTitle}`} description={description} ogImage="/og/default.png">
  <!-- Hero: typography carries the identity; the Arabic name is part of the brand -->
  <section class="border-b border-line" id="hero">
    <div class="container-site pb-16 pt-20 sm:pb-24 sm:pt-28">
      <p class="rise font-arabic text-left text-2xl text-accent sm:text-3xl" lang="ar" dir="rtl" aria-hidden="true">
        محمود كامل
      </p>
      <h1 class="rise rise-2 font-display mt-1 text-[clamp(3rem,9vw,7rem)] font-extrabold leading-[0.95]">
        {displayName}
      </h1>
      <p class="rise rise-3 mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        {jobTitle} in Cairo. {site.tagline}
      </p>
      <div class="rise rise-4 mt-8 flex flex-wrap items-center gap-3">
        <a href={u('/#projects')} class="btn btn-primary">See the work</a>
        <a href={`mailto:${site.email}`} class="btn btn-secondary">Get in touch</a>
      </div>
      <p class="rise rise-5 mt-10 text-sm text-muted">
        {site.location}
      </p>
      <div class="rise rise-5 mt-1 flex items-center gap-5 text-sm">
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
      </div>
    </div>
  </section>

  <!-- Selected work: an editorial index, not a card grid -->
  <section class="py-16 sm:py-24" id="projects">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">أعمال مختارة</p>
          <h2 class="font-display mt-1 text-3xl font-extrabold tracking-tight sm:text-5xl">Selected work</h2>
        </div>
        <a href={u('/projects')} class="btn btn-secondary mb-1 shrink-0">All {projects.length} projects</a>
      </div>

      <ul class="mt-10 list-none" data-work-index>
        {featured.map((project, i) => <ProjectRow project={project} n={featuredStart + i + 1} />)}
      </ul>
    </div>
  </section>

  <!-- Skills -->
  <section class="border-y border-line bg-surface py-16 sm:py-24" id="skills">
    <div class="container-site">
      <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">أدوات</p>
      <h2 class="font-display mt-1 text-3xl font-extrabold tracking-tight sm:text-5xl">Tools I reach for</h2>

      <dl class="mt-10 grid gap-x-12 gap-y-8 sm:grid-cols-2">
        {
          skills.map((group) => (
            <div>
              <dt class="text-sm font-semibold text-fg">{group.area}</dt>
              <dd class="mt-3 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- About -->
  <section class="py-16 sm:py-24" id="about">
    <div class="container-site grid items-start gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div>
        <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">نبذة</p>
        <h2 class="font-display mt-1 text-3xl font-extrabold tracking-tight sm:text-5xl">A little about me</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{site.bio}</p>
        <a href={u('/about')} class="btn btn-ghost mt-4 -ms-3 text-accent">Read the full story</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:mt-14">
        <div class="border border-line p-6">
          <p class="font-display text-4xl font-extrabold text-accent">{projects.length}</p>
          <p class="mt-1 text-sm text-muted">in-depth case studies</p>
        </div>
        <div class="border border-line p-6">
          <p class="font-display text-4xl font-extrabold text-accent">AR / EN</p>
          <p class="mt-1 text-sm text-muted">every product, both languages</p>
        </div>
        <div class="border border-line p-6 sm:col-span-2">
          <p class="text-sm font-semibold">Currently</p>
          <p class="mt-1 text-sm text-muted">Open to remote roles and freelance work — the fastest way in is email.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="pb-20 sm:pb-28" id="contact">
    <div class="container-site">
      <div class="border-y border-line py-14 text-center sm:py-20">
        <p class="font-arabic text-left text-lg text-accent" lang="ar" dir="rtl">تواصل</p>
        <h2 class="font-display mx-auto mt-1 max-w-2xl text-3xl font-extrabold tracking-tight sm:text-5xl">
          Have something worth building?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-muted">
          I'm open to remote work and interesting collaborations. Email gets the fastest reply.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">Say hello</a>
          <a href={u('/contact')} class="btn btn-secondary">Contact page</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
